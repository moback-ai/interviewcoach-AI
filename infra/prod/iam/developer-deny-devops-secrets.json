{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAllInterviewCoachSecrets",
      "Effect": "Deny",
      "Action": "secretsmanager:*",
      "Resource": [
        "arn:aws:secretsmanager:ap-south-1:328991713462:secret:interviewcoach/*"
      ]
    },
    {
      "Sid": "DenySSHKeysAndParameters",
      "Effect": "Deny",
      "Action": [
        "ssm:GetParameter*",
        "ssm:GetParameters*",
        "ssm:GetParametersByPath",
        "ssm:DescribeParameters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyInfraAndDataPlane",
      "Effect": "Deny",
      "Action": [
        "ec2:*",
        "rds:*",
        "elasticache:*",
        "autoscaling:*",
        "elasticloadbalancing:*",
        "cloudformation:*",
        "iam:*",
        "s3:*",
        "lambda:*",
        "ecs:*",
        "eks:*",
        "bedrock:*",
        "transcribe:*",
        "sns:*",
        "sqs:*",
        "events:*",
        "scheduler:*",
        "apigateway:*",
        "cloudfront:*",
        "route53:*",
        "acm:*",
        "ecr:*",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DeleteLogGroup",
        "logs:DeleteLogStream"
      ],
      "Resource": "*"
    }
  ]
}
