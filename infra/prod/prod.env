# PROD — resolved infra names (no secrets). Source: infra/prod/scripts/load-prod-env.sh
# Edit here; scripts pick these up automatically.

# --- S3 ---
STATIC_BUCKET=ic-static-prod
USER_FILES_BUCKET=ic-user-files-prod
S3_BUCKET=ic-user-files-prod
STT_S3_BUCKET=ic-user-files-prod
# Legacy Plan B buckets — used only by 07b-migrate-legacy-storage.sh; remove after migration
S3_BUCKET_PRIMARY=interviewcoach-storage-1776239119
S3_BUCKET_SECONDARY=interviewcoach-storage-1776239227
S3_REGION=ap-south-1

# --- AWS ---
AWS_REGION=ap-south-1
STACK_NAME=interviewcoach-prod-s3
OLD_S3_STACK_NAME=interviewcoach-prod-hybrid-s3
CF_STACK_NAME=interviewcoach-prod-cloudfront
SECRET_ID=interviewcoach/prod/app
INSTANCE_ROLE_NAME=InterviewCoachBackendSecretsRole
INSTANCE_PROFILE_NAME=InterviewCoachBackendSecretsProfile
POLICY_NAME=InterviewCoachProdApi

# --- ECR ---
ECR_REGISTRY=328991713462.dkr.ecr.ap-south-1.amazonaws.com
ECR_API_REPO=interviewcoach-api
ECR_WEB_REPO=interviewcoach-web
IMAGE_TAG=prod-20260629

# --- EC2 / SSH ---
SSH_USER=ubuntu
SSH_KEY_PATH=~/.ssh/interviewcoach-key-v2.pem
SSH_KEY_SECRET=interviewcoach/prod/ec2-ssh-key
