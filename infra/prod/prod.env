SUBNET_ID=subnet-00662d4d6964a6ee4
KEY_NAME=interviewcoach-key-v2
AMI_ID=ami-0a1b0c508e1fa9fce
INSTANCE_TYPE=c6i.large
API_HOST=ubuntu@43.205.215.217
API_INSTANCE_ID=i-0642ed38dc5b8b740
API_PUBLIC_IP=43.205.215.217
API_ORIGIN_DOMAIN=ec2-43-205-215-217.ap-south-1.compute.amazonaws.com
LOCAL_PATH=/apps/storage

# --- RDS ---
RDS_INSTANCE_ID=interviewcoach-db
DB_HOST=interviewcoach-db.clmm8cymmic9.ap-south-1.rds.amazonaws.com
