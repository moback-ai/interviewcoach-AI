# PROD — resolved infra names (no secrets). Source: infra/prod/scripts/load-prod-env.sh
# Edit here; scripts pick these up automatically.

# --- S3 ---
STATIC_BUCKET=ic-static-prod
USER_FILES_BUCKET=ic-user-files-prod
S3_BUCKET=ic-user-files-prod
STT_S3_BUCKET=ic-user-files-prod
# Legacy Plan B buckets — used only by 07b-migrate-legacy-storage.sh; keep until decommission
S3_BUCKET_PRIMARY=interviewcoach-storage-1776239119
S3_BUCKET_SECONDARY=interviewcoach-storage-1776239227
S3_REGION=ap-south-1

# --- AWS ---
AWS_REGION=ap-south-1
STACK_NAME=interviewcoach-prod-s3
OLD_S3_STACK_NAME=interviewcoach-prod-hybrid-s3
CF_STACK_NAME=interviewcoach-prod-cloudfront
SECRET_ID=interviewcoach/prod/app
INSTANCE_ROLE_NAME=InterviewCoachBackendSecretsRole
INSTANCE_PROFILE_NAME=InterviewCoachBackendSecretsProfile
POLICY_NAME=InterviewCoachProdApi

# --- ECR ---
ECR_REGISTRY=328991713462.dkr.ecr.ap-south-1.amazonaws.com
ECR_API_REPO=interviewcoach-api
ECR_WEB_REPO=interviewcoach-web
IMAGE_TAG=prod-20260630

# --- Compute (ALB + ASG) / SSH ---
SSH_USER=ubuntu
SSH_KEY_PATH=~/.ssh/interviewcoach-key-v2.pem
SSH_KEY_SECRET=interviewcoach/prod/ec2-ssh-key
# Retired — do not deploy single-EC2 stack (11-aws-fresh-ec2.sh blocked)
EC2_STACK_NAME=
VPC_ID=vpc-02d05a1b90499b22d
SUBNET_ID=subnet-00662d4d6964a6ee4
KEY_NAME=interviewcoach-key-v2
AMI_ID=ami-0a1b0c508e1fa9fce
INSTANCE_TYPE=c6i.xlarge
COMPUTE_STACK_NAME=interviewcoach-prod-compute
PROXY_STACK_NAME=interviewcoach-prod-proxy
ASG_NAME=interviewcoach-prod-api-asg
API_ASG_SG_ID=sg-0a80d7e8d63b3474e
ASG_DESIRED_CAPACITY=2
ASG_MIN_SIZE=2
ASG_MAX_SIZE=4
# Business hours schedule (IST): API ASG 10:00–19:00 — cron is UTC
ASG_SCHEDULE_UP_CRON='30 4 * * *'
ASG_SCHEDULE_DOWN_CRON='30 13 * * *'
PUBLIC_SUBNET_IDS=subnet-00662d4d6964a6ee4,subnet-090e9d10afc24205f,subnet-0f1a1e9146d12a37b
RDS_SECURITY_GROUP_ID=sg-0309dacce73c934dd
RDS_PROXY_SECRET_ID=interviewcoach/prod/rds-proxy
INFRA_LAYOUT=prod
ALB_DNS_NAME=interviewcoach-prod-alb-611234576.ap-south-1.elb.amazonaws.com
# SSH: bash infra/prod/scripts/ssh-prod.sh (picks first in-service ASG instance; none off-hours)
API_ORIGIN_DOMAIN=interviewcoach-prod-alb-611234576.ap-south-1.elb.amazonaws.com
LOCAL_PATH=/apps/storage
# GitHub Actions deploy (production environment secrets)
GITHUB_DEPLOY_ROLE_ARN=arn:aws:iam::328991713462:role/InterviewCoach-GitHubActions-Deploy

# --- RDS ---
RDS_INSTANCE_ID=interviewcoach-db
DB_HOST=interviewcoach-prod-proxy.proxy-clmm8cymmic9.ap-south-1.rds.amazonaws.com
DB_NAME=interview_db
DB_USER=interview_user

# --- Domain / CDN (canonical prod URL: www) ---
APEX_DOMAIN=ugaanlabs.ai
DOMAIN=https://www.ugaanlabs.ai
BACKEND_API_BASE=https://www.ugaanlabs.ai
PUBLIC_STORAGE_URL=https://www.ugaanlabs.ai/storage
FRONTEND_DOMAIN=www.ugaanlabs.ai
# SSH hardening (10c): set CIDR and/or enable auto-detect of your public IP when running the script
SSH_ALLOW_CIDR=
SSH_AUTO_DETECT_IP=1
# CloudWatch alarm notifications (comma-separated); confirm AWS SNS emails after setup
ALARM_EMAILS=govardhanr@moback.com,kishoren@moback.com
ALARM_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:328991713462:interviewcoach-prod-alarms
CF_DIST_ID=E5YX3P309ZTK0
CF_DOMAIN=d1rw8rj2lqcrak.cloudfront.net
ACM_CERT_ARN=arn:aws:acm:us-east-1:328991713462:certificate/f6131ad0-7d17-4d45-992d-0ebdb5dc3fdb

# --- STT (OpenRouter primary, Amazon Transcribe fallback) ---
STT_PRIMARY=openrouter
STT_FALLBACK=amazon
REDIS_URL=redis://interviewcoach-prod-redis.oezcxk.ng.0001.aps1.cache.amazonaws.com:6379/0

# --- Bedrock ---
BEDROCK_REGION=ap-south-1
BEDROCK_CHAT_MODEL=apac.amazon.nova-lite-v1:0
BEDROCK_REPORT_MODEL=apac.amazon.nova-pro-v1:0

# --- Payments (keep test until Dodo live cutover) ---
DODO_ENV=test
