# --- Domain / CDN (canonical prod URL: www) ---
APEX_DOMAIN=ugaanlabs.ai
DOMAIN=https://www.ugaanlabs.ai
BACKEND_API_BASE=https://www.ugaanlabs.ai
PUBLIC_STORAGE_URL=https://www.ugaanlabs.ai/storage
FRONTEND_DOMAIN=www.ugaanlabs.ai
# Optional: restrict SSH on API SG (CIDR); leave empty to skip SSH rule changes
SSH_ALLOW_CIDR=
CF_DIST_ID=E5YX3P309ZTK0
CF_DOMAIN=d1rw8rj2lqcrak.cloudfront.net
ACM_CERT_ARN=arn:aws:acm:us-east-1:328991713462:certificate/f6131ad0-7d17-4d45-992d-0ebdb5dc3fdb

# --- STT (OpenRouter primary, Amazon Transcribe fallback) ---
STT_PRIMARY=openrouter
STT_FALLBACK=amazon
REDIS_URL=redis://redis:6379/0

# --- Bedrock ---
BEDROCK_REGION=ap-south-1
BEDROCK_CHAT_MODEL=apac.amazon.nova-lite-v1:0
BEDROCK_REPORT_MODEL=apac.amazon.nova-pro-v1:0

# --- Payments (DODO_ENV: test until cutover) ---
