#!/bin/sh
# Remove unwanted co-author trailers before the commit message is finalized.
msgfile="$1"
[ -f "$msgfile" ] || exit 0

case "$(uname -s)" in
  Darwin) SED="sed -i ''" ;;
  *) SED="sed -i" ;;
esac

$SED \
  -e '/cursoragent@cursor\.com/d' \
  -e '/^Co-authored-by: Cursor/d' \
  -e '/^Made-with: Cursor/d' \
  -e '/^Made-with:.*Cursor/d' \
  -e '/^Co-authored-by:.*[Cc]opilot/d' \
  -e '/^Co-authored-by: Codex/d' \
  -e '/codex@openai\.com/d' \
  -e '/^Signed-off-by: Cursor/d' \
  "$msgfile"
exit 0
