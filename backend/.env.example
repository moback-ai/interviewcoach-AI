# ── Database ──────────────────────────────────────────
DB_HOST=YOUR_DB_PRIVATE_IP
DB_PORT=5432
DB_NAME=interview_db
DB_USER=interview_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── JWT Auth ───────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# ── App ────────────────────────────────────────────────
DOMAIN=https://ugaanlabs.ai
STORAGE_PATH=/apps/storage
PUBLIC_STORAGE_URL=https://ugaanlabs.ai/storage

# ── Email / Password reset ─────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_SSL=false
MAIL_FROM=no-reply@ugaanlabs.ai

# ── AI ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
# Plan B production: point to AI host private IP (see docs/PRODUCTION_CHECKLIST.md)
OLLAMA_HOST=http://AI_PRIVATE_IP:11434
OLLAMA_HEALTH_URL=http://AI_PRIVATE_IP:11434/api/tags
OLLAMA_MODEL=llama3.2:3b
# Shorter replies = faster turns (64–1024 tokens)
OLLAMA_NUM_PREDICT=384
# Fast template questions by default (set false + QUESTION_GEN_USE_OLLAMA=true for full AI pipeline)
QUESTION_GEN_FORCE_LOCAL=true
QUESTION_GEN_USE_OLLAMA=false
QUESTION_GEN_OLLAMA_TIMEOUT_SECONDS=90
# JD file upload uses fast local parsing by default (avoids nginx 504 timeouts)
JD_PARSE_USE_OLLAMA=false
JD_PARSE_OLLAMA_TIMEOUT_SECONDS=25

# Interview page: browser voice is faster; server Piper TTS is opt-in
INTERVIEW_SERVER_TTS=false
INTERVIEW_FAST_WRAPUP=true
INTERVIEW_RESPONSE_TIMEOUT_SECONDS=45

# ── Whisper ────────────────────────────────────────────
WHISPER_MODEL=base
# true on AI host only; false on API host (see docs/PRODUCTION_CHECKLIST.md)
ENABLE_AI_WARMUP=false
WHISPER_BEAM_SIZE=1
OLLAMA_DIAGNOSTICS_CACHE_SECONDS=30

# ── Upload ─────────────────────────────────────────────
UPLOAD_FOLDER=/apps/storage
MAX_CONTENT_MB=200

# ── Internal API ──────────────────────────────────────────
BACKEND_API_BASE=http://127.0.0.1:5000

# ── Admin logs ─────────────────────────────────────────────
ADMIN_LOG_ROOT=/apps/logs
ADMIN_LOG_VIEWER_EMAILS=admin@example.com
ADMIN_LOG_VIEWER_USERNAMES=your_admin_username
ADMIN_LOG_IP_ALLOWLIST=

# Database connection pool (Plan B API: 5–40)
DB_POOL_MIN=5
DB_POOL_MAX=40
