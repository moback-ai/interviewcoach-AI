# Local dev: leave AWS_SECRETS_MANAGER_SECRET_ID unset — config loads from process env / .env.
# Set RUNTIME_CONFIG_ALLOW_ENV=true in backend/.env for laptop runs (see backend/.env.prod.example).
# PROD: see backend/secrets.prod.example.json (Secrets Manager) and docs/SECRETS_ONLY.md
# Production server: set AWS_SECRETS_MANAGER_SECRET_ID=interviewcoach/prod/app

RUNTIME_CONFIG_ALLOW_ENV=true

# ── Database ──────────────────────────────────────────
DB_HOST=YOUR_DB_PRIVATE_IP
DB_PORT=5432
DB_NAME=interview_db
DB_USER=interview_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── JWT Auth ───────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# ── App ────────────────────────────────────────────────
DOMAIN=https://www.ugaanlabs.ai
STORAGE_PATH=/apps/storage
# Legacy; sensitive files are served via /api/files/ (JWT). Optional for old URL parsing.
PUBLIC_STORAGE_URL=https://www.ugaanlabs.ai/storage

# ── Email / Password reset ─────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_SSL=false
MAIL_FROM=no-reply@ugaanlabs.ai

# ── AI (Amazon Bedrock — prod and laptop) ─────────────
# Credentials: standard AWS chain only (instance role, `aws sso login`, AWS_PROFILE).
# Never put AWS access keys in this file. See docs/BEDROCK_GPT56_TERRA.md.
LLM_PROVIDER=bedrock
BEDROCK_REGION=ap-south-1
# REQUIRED. Inference profile ID verified in BEDROCK_REGION. GPT-5.6 Terra cannot use the
# bare catalog ID (openai.gpt-5.6-terra) from ap-south-1:
#   in.openai.gpt-5.6-terra      India geo profile (ap-south-1 + ap-south-2 only)
#   global.openai.gpt-5.6-terra  any commercial Region
BEDROCK_CHAT_MODEL=in.openai.gpt-5.6-terra
# auto = send temperature, drop it automatically if the model rejects it
LLM_SEND_TEMPERATURE=auto
# GPT-5.6 reasoning effort: none|low|medium|high|xhigh|max. Reasoning tokens count against
# each call's max tokens; "none" keeps today's token budgets and latency. Unset = model default.
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0.6
# Reject prompts above this many characters before calling AWS
LLM_MAX_INPUT_CHARS=400000
BEDROCK_MAX_ATTEMPTS=3
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=120
# Health checks reuse the live model probe for this long (each probe is billable)
BEDROCK_DIAGNOSTICS_CACHE_SECONDS=120

# ── AI (legacy / local Ollama) ─────────────────────────
# Legacy EC2 (retired): Ollama on separate AI host — prod uses Bedrock (devsecops-platform docs)
OLLAMA_HOST=http://AI_PRIVATE_IP:11434
OLLAMA_HEALTH_URL=http://AI_PRIVATE_IP:11434/api/tags
OLLAMA_MODEL=llama3.2:3b
# Shorter replies = faster turns (64–1024 tokens) for Ollama; Bedrock uses LLM_MAX_TOKENS
OLLAMA_NUM_PREDICT=384
# Default Bedrock/Ollama max output when a call does not pass an explicit max_tokens
LLM_MAX_TOKENS=8192
INTERVIEW_MAX_CONCURRENT=12
INTERVIEW_QUEUE_WAIT_SECONDS=90
# API forwards mic audio to Whisper on the AI host (private VPC URL, not public internet)
# TRANSCRIBE_SERVICE_URL=http://172.31.46.208:5001
# TRANSCRIBE_INTERNAL_TOKEN=change-me
QUESTION_GEN_OLLAMA_TIMEOUT_SECONDS=300
GENERATE_ANSWERS_TIMEOUT_SECONDS=600
JD_PARSE_OLLAMA_TIMEOUT_SECONDS=25

# Interview page: browser voice is faster; server Piper TTS is opt-in
INTERVIEW_SERVER_TTS=false
INTERVIEW_RESPONSE_TIMEOUT_SECONDS=90

# ── Whisper ────────────────────────────────────────────
WHISPER_MODEL=base
# true on AI host only; false on API host (local dev: keep false)
ENABLE_AI_WARMUP=false
WHISPER_BEAM_SIZE=1
OLLAMA_DIAGNOSTICS_CACHE_SECONDS=30

# ── Upload ─────────────────────────────────────────────
UPLOAD_FOLDER=/apps/storage
MAX_CONTENT_MB=200

# ── Dodo Payments ──────────────────────────────────────
# Required for server-side checkout + webhooks (also add to AWS Secrets Manager JSON in production)
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID=pdt_xxx
# test | live — selects API host unless DODO_API_BASE_URL is set
DODO_ENV=test
# Optional overrides (defaults: test.dodopayments.com / api.dodopayments.com)
# DODO_API_BASE_URL=https://test.dodopayments.com
# DODO_CHECKOUT_AMOUNT_PAISE=49900
# DODO_CHECKOUT_EXPIRY_MINUTES=30
# Lifetime free started interviews per user (includes retakes); 3rd+ requires checkout
FREE_INTERVIEW_LIMIT=2
# Local webhook testing only — never enable in production
# DODO_WEBHOOK_TEST_MODE=true

# Optional: batch-expire abandoned checkout intents
# POST /api/internal/checkout-intents/expire-stale  (header X-Internal-Token)
# Generate: openssl rand -hex 32
# CHECKOUT_MAINTENANCE_TOKEN=f728c3c87c9fb413f424a0e3f3bd41a40af7fac1698d72c2fabdfc401a86efa4
# See docs/PAYMENTS_CHECKOUT.md (EventBridge during 10:00–19:00 IST)

# ── Internal API ──────────────────────────────────────────
BACKEND_API_BASE=http://127.0.0.1:5000

# ── Admin logs ─────────────────────────────────────────────
ADMIN_LOG_ROOT=/apps/logs
ADMIN_LOG_VIEWER_EMAILS=admin@example.com
ADMIN_LOG_VIEWER_USERNAMES=your_admin_username
ADMIN_LOG_IP_ALLOWLIST=

# Database connection pool (legacy EC2 API: 5–40)
DB_POOL_MIN=5
DB_POOL_MAX=40
