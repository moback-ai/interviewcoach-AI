# Laptop validation ONLY — not used on prod servers.
#
# Prod API hosts load config exclusively from AWS Secrets Manager:
#   secret id: interviewcoach/prod/app
#   template:  backend/secrets.prod.example.json
#
# On prod EC2 only these process env vars are allowed:
#   AWS_REGION=ap-south-1
#   AWS_SECRETS_MANAGER_SECRET_ID=interviewcoach/prod/app
#
# cp backend/.env.prod.example backend/.env  (never commit .env)

RUNTIME_CONFIG_ALLOW_ENV=true
AWS_REGION=ap-south-1
# Do NOT set AWS_SECRETS_MANAGER_SECRET_ID on laptop unless testing against real AWS secrets.

# ── Database (tunnel or local postgres for laptop test) ──
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=interview_db
DB_USER=interview_user
DB_PASSWORD=REPLACE_ME

JWT_SECRET=laptop-test-jwt-secret-minimum-sixty-four-characters-long-only

DOMAIN=http://127.0.0.1:5001
STORAGE_PATH=./local_storage
UPLOAD_FOLDER=./local_storage
BACKEND_API_BASE=http://127.0.0.1:5001

# ── PROD (mirror values in Secrets Manager JSON) ──
LLM_PROVIDER=bedrock
BEDROCK_REGION=ap-south-1
BEDROCK_CHAT_MODEL=apac.amazon.nova-lite-v1:0
BEDROCK_REPORT_MODEL=apac.amazon.nova-pro-v1:0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.6

STT_PRIMARY=openrouter
STT_FALLBACK=amazon
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

STT_S3_BUCKET=
S3_BUCKET=
STORAGE_BACKEND=local
TRANSCRIBE_REGION=ap-south-1
TRANSCRIBE_LANGUAGE_CODE=en-US

INTERVIEW_SERVER_TTS=true
INTERVIEW_MAX_CONCURRENT=12

DODO_PAYMENTS_API_KEY=REPLACE_ME
DODO_WEBHOOK_SECRET=REPLACE_ME
DODO_PRODUCT_ID=REPLACE_ME
DODO_ENV=test

REDIS_URL=redis://127.0.0.1:6379/0

# Do NOT set on prod after cutover:
# TRANSCRIBE_SERVICE_URL=
# OLLAMA_HOST=

DB_POOL_MIN=2
DB_POOL_MAX=20
