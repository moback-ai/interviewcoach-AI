# PROD API image — app layer on top of deps base (Dockerfile.deps).
# CI passes DEPS_IMAGE=.../interviewcoach-api:deps-latest
ARG DEPS_IMAGE
FROM ${DEPS_IMAGE}

WORKDIR /app

COPY backend/ .

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:5000/api/health" || exit 1

# 2 workers when REDIS_URL is set (shared rate limits + interview slots)
CMD ["gunicorn", "-w", "2", "--threads", "4", "-b", "0.0.0.0:5000", \
     "--timeout", "300", "--max-requests", "2000", "--max-requests-jitter", "200", "app:app"]
